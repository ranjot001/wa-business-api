# Root .env.example
#
# Copy to .env at the repo root for docker compose and for Prisma CLI commands
# (prisma reads packages/db/.env, see that file). Each app also has its own
# .env.example; the per-app files are what the running processes read.

# --- docker compose (postgres service) ---
# Matches the credentials baked into docker-compose.yml. Change all three
# together if you change them at all.
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm

# Host ports the containers publish on. Override either one when something else
# on your machine already owns the default port (a native Postgres install is
# the usual culprit). The container side never changes.
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- shared by every app ---
# Postgres connection string. Local value points at the docker compose service.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
# Redis connection string. Local value points at the docker compose service.
REDIS_URL=redis://localhost:6379
