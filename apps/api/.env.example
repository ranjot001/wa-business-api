# apps/api/.env.example -> copy to apps/api/.env
#
# Every variable here is validated by src/config/env.ts at boot. A missing or
# malformed value stops the process immediately with the offending key named.

# development | test | production. Controls pretty logging and Prisma log level.
NODE_ENV=development

# Port the HTTP server binds to. Railway injects its own PORT, do not hardcode
# it there.
PORT=4000

# Postgres connection string. Required, must be a valid URL.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm

# Redis connection string. Required, must be a valid URL. Used for the
# readiness probe and for enqueuing BullMQ jobs.
REDIS_URL=redis://localhost:6379

# Browser origins allowed by CORS. Comma separated, no trailing slash.
# e.g. https://app.example.com,https://staging.example.com
WEB_ORIGIN=http://localhost:3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Secret the access tokens are signed with. At least 32 characters. Generate
# one with `openssl rand -base64 48`. Rotating it signs out every session and
# invalidates every outstanding password reset link.
JWT_SECRET=replace-with-at-least-32-random-characters

# Access token lifetime. Any ms/vercel duration string.
JWT_ACCESS_TTL=15m

# Refresh token lifetime in days. Matches the refresh cookie Max-Age.
REFRESH_TTL_DAYS=30

# Public URL of the web app. Used to build the links inside emails.
APP_URL=http://localhost:3000

# Resend API key. Leave unset locally: without it, password reset and
# invitation emails are written to the log instead of being sent.
# RESEND_API_KEY=re_...

# From address for transactional email.
MAIL_FROM=CRM <onboarding@resend.dev>
