# apps/web/.env.example -> copy to apps/web/.env.local
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. Never put
# a secret behind that prefix.

# Base URL of the API, without a trailing slash and without the /v1 suffix
# (lib/api.ts appends /v1). Read by the server at request time, so changing it
# takes a restart and not a rebuild. This is the one to set on Railway.
# Production value is the public Railway API URL.
API_URL=http://localhost:4000

# Same value, for code that runs in the browser. Inlined at build time, so a
# change here only takes effect after a rebuild and it cannot be fixed by
# restarting the service. API_URL wins when both are set; this is the fallback.
NEXT_PUBLIC_API_URL=http://localhost:4000
