# apps/web/.env.example -> copy to apps/web/.env.local
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. Never put
# a secret behind that prefix.

# Base URL of the API, without a trailing slash and without the /v1 suffix.
#
# Used in two places, both server side:
#   - the /api/v1/* rewrite in next.config.mjs, which is how the browser
#     reaches the API at all
#   - server components, through getApiUrl() in lib/api.ts
#
# Read when the server boots, so changing it takes a restart and not a
# rebuild. This is the one to set on Railway.
API_URL=http://localhost:4000

# Optional fallback for the same value, kept for code that runs in the browser
# and cannot read API_URL. Nothing uses it today: every browser side fetch goes
# to the relative /api/v1 path instead. It is inlined at build time, so setting
# it after a build has no effect. Prefer API_URL.
# NEXT_PUBLIC_API_URL=http://localhost:4000
