# apps/worker/.env.example -> copy to apps/worker/.env
#
# Validated by src/env.ts at boot, same fail-fast contract as the API.

# development | test | production. Controls pretty logging.
NODE_ENV=development

# Postgres connection string. Required, must be a valid URL. The worker shares
# packages/db with the API and points at the same database.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm

# Redis connection string. Required, must be a valid URL. This is where BullMQ
# queues live.
REDIS_URL=redis://localhost:6379

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# How many jobs this process runs concurrently. Raise for IO bound work, keep
# low while a single Meta phone number rate limit is the bottleneck.
WORKER_CONCURRENCY=5

# Same AES-256-GCM key the api uses. The worker decrypts Meta access tokens to
# download media, so both processes must have exactly this same value.
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Graph API version every outbound Meta call uses.
META_GRAPH_VERSION=v20.0

# Cloudflare R2, where inbound media is stored. All four are optional: without
# them the worker boots and warns, and media downloads fail with a clear
# reason rather than the process refusing to start.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
