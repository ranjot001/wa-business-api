{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @crm/worker... run build",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/.npmrc",
      "/.nvmrc"
    ]
  },
  "deploy": {
    "startCommand": "node apps/worker/dist/main.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
