meta {
  name: Forgot Password
  type: http
  seq: 5
}

post {
  url: {{base_url}}/v1/auth/forgot-password
  body: json
  auth: none
}

headers {
  accept: application/json
  content-type: application/json
}

body:json {
  {
    "email": "{{email}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  Always 204. Without RESEND_API_KEY the api logs the link instead of sending
  it, so the token is in the api console output.
}
