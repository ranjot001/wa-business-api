meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/auth/login
  body: json
  auth: none
}

headers {
  accept: application/json
  content-type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setEnvVar("access_token", res.body.access_token);
}

docs {
  401 INVALID_CREDENTIALS for both a wrong password and an unknown email, so
  the endpoint cannot be used to find out which addresses are registered.
}
