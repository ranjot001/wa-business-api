meta {
  name: Reset Password
  type: http
  seq: 6
}

post {
  url: {{base_url}}/v1/auth/reset-password
  body: json
  auth: none
}

headers {
  accept: application/json
  content-type: application/json
}

body:json {
  {
    "token": "{{reset_token}}",
    "password": "{{password}}"
  }
}

docs {
  Set {{reset_token}} from the link the api logged. Single use: the token stops
  verifying once the password changes, and every other session is revoked.
}
