meta {
  name: Mark Read
  type: http
  seq: 4
}

post {
  url: {{base_url}}/v1/conversations/{{conversation_id}}/read
  body: none
  auth: none
}

headers {
  accept: application/json
  authorization: Bearer {{access_token}}
  x-workspace-id: {{workspace_id}}
}

assert {
  res.status: eq 200
}

docs {
  Sets unread_count to 0 and returns the conversation.
}
