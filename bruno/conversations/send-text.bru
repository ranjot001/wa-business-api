meta {
  name: Send Text
  type: http
  seq: 6
}

post {
  url: {{base_url}}/v1/conversations/{{conversation_id}}/messages
  body: json
  auth: none
}

headers {
  accept: application/json
  content-type: application/json
  authorization: Bearer {{access_token}}
  x-workspace-id: {{workspace_id}}
}

body:json {
  {
    "type": "text",
    "text": "Hello from Bruno"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("message_id", res.body.id);
}

docs {
  Stored as queued and handed to the worker, which sends it through Meta. Watch
  it move queued, sent, delivered, read with messages / Get Message.

  409 WINDOW_CLOSED when the contact last wrote in more than 24 hours ago, with
  details.last_inbound_at and details.expires_at. Send a template instead.
}
