meta {
  name: List Invitations
  type: http
  seq: 2
}

get {
  url: {{base_url}}/v1/invitations
  body: none
  auth: none
}

headers {
  accept: application/json
  authorization: Bearer {{access_token}}
  x-workspace-id: {{workspace_id}}
}

assert {
  res.status: eq 200
}

docs {
  Pending invitations only, cursor paginated.
}
