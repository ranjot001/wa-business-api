meta {
  name: Get Media Url
  type: http
  seq: 2
}

get {
  url: {{base_url}}/v1/media/{{media_id}}/url
  body: none
  auth: none
}

headers {
  accept: application/json
  authorization: Bearer {{access_token}}
  x-workspace-id: {{workspace_id}}
}

assert {
  res.status: eq 200
}

docs {
  A signed R2 url good for 15 minutes, with its expires_at. 409
  MEDIA_NOT_READY while an inbound download is still pending or has failed.
}
