meta {
  name: List Members
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/members
  body: none
  auth: none
}

headers {
  accept: application/json
  authorization: Bearer {{access_token}}
  x-workspace-id: {{workspace_id}}
}

assert {
  res.status: eq 200
}

docs {
  Cursor paginated. Add ?limit= and ?cursor= to page through.
}
