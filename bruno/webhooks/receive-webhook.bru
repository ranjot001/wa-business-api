meta {
  name: Receive Webhook
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/webhooks/whatsapp
  body: json
  auth: none
}

headers {
  content-type: application/json
  x-hub-signature-256: sha256={{meta_signature}}
}

body:json {
  {
    "object": "whatsapp_business_account",
    "entry": [
      {
        "id": "102290129340398",
        "changes": [
          {
            "field": "messages",
            "value": {
              "messaging_product": "whatsapp",
              "metadata": {
                "display_phone_number": "15550100000",
                "phone_number_id": "{{phone_number_id}}"
              },
              "contacts": [{ "profile": { "name": "Ranjot" }, "wa_id": "919876543210" }],
              "messages": [
                {
                  "from": "919876543210",
                  "id": "wamid.bruno.text.1",
                  "timestamp": "1759104000",
                  "type": "text",
                  "text": { "body": "Hello from Bruno" }
                }
              ]
            }
          }
        ]
      }
    ]
  }
}

docs {
  Sending this from Bruno needs a signature over the exact request bytes, which
  Bruno cannot compute for you. Two options:

  1. Set {{meta_signature}} by hand. With the body saved to a file:

       openssl dgst -sha256 -hmac "$META_APP_SECRET" -hex < body.json

  2. Easier: use curl, which signs and sends in one step.

       BODY='{"object":"whatsapp_business_account", ...}'
       SIG=$(printf %s "$BODY" | openssl dgst -sha256 -hmac "$META_APP_SECRET" -hex | awk '{print $2}')
       curl -X POST "$BASE_URL/v1/webhooks/whatsapp" \
         -H 'content-type: application/json' \
         -H "x-hub-signature-256: sha256=$SIG" \
         -d "$BODY"

  The signature covers the bytes on the wire, so reformatting the body after
  signing it invalidates it. Any mismatch is a 403 and nothing is enqueued.

  Replaying an identical body is safe and expected: messages.wa_message_id is
  unique, so the second and third delivery add no rows.
}
