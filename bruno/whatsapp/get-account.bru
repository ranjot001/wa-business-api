meta {
  name: Get Account
  type: http
  seq: 2
}

get {
  url: {{base_url}}/v1/whatsapp/account
  body: none
  auth: none
}

headers {
  accept: application/json
  authorization: Bearer {{access_token}}
  x-workspace-id: {{workspace_id}}
}

assert {
  res.status: eq 200
}

docs {
  The workspace's connected number. 404 when none is connected yet.
}
