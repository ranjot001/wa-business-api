# packages/db/.env.example -> copy to packages/db/.env
#
# The Prisma CLI (migrate, studio, generate) reads this file because it runs
# with packages/db as its working directory. The API and worker do not read it.

# Postgres connection string used by prisma migrate dev / deploy / studio.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm

# Separate scratch database Prisma uses to detect drift and to validate
# migrations. Optional locally (Prisma creates a temporary one), required when
# the database user cannot create databases, e.g. on Railway.
# SHADOW_DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_shadow
